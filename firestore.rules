rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferredLevel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'preferredLevel', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 128
        && data.preferredLevel in ['little', 'student', 'advanced']
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidLesson(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'topic', 'level', 'explanationText', 'analogy', 'diagramJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'topic', 'level', 'explanationText', 'analogy', 'diagramJson', 'drawingsJson', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.topic is string && data.topic.size() <= 200
        && data.level in ['little', 'student', 'advanced']
        && data.explanationText is string && data.explanationText.size() <= 2000
        && data.analogy is string && data.analogy.size() <= 1000
        && data.diagramJson is string && data.diagramJson.size() <= 200000
        && (!('drawingsJson' in data) || (data.drawingsJson is string && data.drawingsJson.size() <= 500000))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // User profile: only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying user profiles

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLevel', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: lessons saved under /users/{userId}/lessons/{lessonId}
      match /lessons/{lessonId} {
        allow get: if isOwner(userId) && isValidId(lessonId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(lessonId)
          && isValidLesson(incoming(), userId)
          && incoming().id == lessonId;

        allow update: if isOwner(userId)
          && isValidId(lessonId)
          && isValidLesson(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['explanationText', 'analogy', 'diagramJson', 'drawingsJson', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(lessonId);
      }
    }
  }
}
